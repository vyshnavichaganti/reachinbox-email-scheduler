# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# PostgreSQL
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox
POSTGRES_DB=reachinbox
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_PORT=9200

# Google OAuth (fill in Stage 2+)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth (fill in Stage 2+)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/auth/slack/callback

# Session / JWT
SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string

# Ethereal Email
# Leave SMTP_USER / SMTP_PASS empty in development to auto-create a test account.
# Or create credentials at https://ethereal.email and paste them here.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReachInbox <noreply@reachinbox.local>"
